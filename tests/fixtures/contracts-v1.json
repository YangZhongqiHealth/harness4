{
  "ActionReceipt": {
    "$defs": {
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "minLength": 1,
            "title": "Artifact Id",
            "type": "string"
          },
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "mime_type": {
            "minLength": 1,
            "title": "Mime Type",
            "type": "string"
          },
          "provenance_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Provenance Refs",
            "type": "array"
          },
          "retention_ref": {
            "minLength": 1,
            "title": "Retention Ref",
            "type": "string"
          },
          "retrieval_ref": {
            "minLength": 1,
            "title": "Retrieval Ref",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "size_bytes": {
            "minimum": 0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "digest",
          "mime_type",
          "size_bytes",
          "retrieval_ref",
          "retention_ref"
        ],
        "title": "ArtifactRef",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "artifact_refs": {
        "default": [],
        "items": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "title": "Artifact Refs",
        "type": "array"
      },
      "operation_id": {
        "minLength": 1,
        "title": "Operation Id",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "status": {
        "enum": [
          "succeeded",
          "failed",
          "unknown_effect"
        ],
        "title": "Status",
        "type": "string"
      },
      "summary": {
        "minLength": 1,
        "title": "Summary",
        "type": "string"
      }
    },
    "required": [
      "operation_id",
      "status",
      "summary"
    ],
    "title": "ActionReceipt",
    "type": "object"
  },
