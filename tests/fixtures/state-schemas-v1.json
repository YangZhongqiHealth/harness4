{
  "OperationView": {
    "$defs": {
      "ActionReceipt": {
        "additionalProperties": false,
        "properties": {
          "artifact_refs": {
            "default": [],
            "items": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "title": "Artifact Refs",
            "type": "array"
          },
          "operation_id": {
            "minLength": 1,
            "title": "Operation Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "unknown_effect"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "status",
          "summary"
        ],
        "title": "ActionReceipt",
        "type": "object"
      },
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "minLength": 1,
            "title": "Artifact Id",
            "type": "string"
          },
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "mime_type": {
            "minLength": 1,
            "title": "Mime Type",
            "type": "string"
          },
          "provenance_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Provenance Refs",
            "type": "array"
          },
          "retention_ref": {
            "minLength": 1,
            "title": "Retention Ref",
            "type": "string"
          },
          "retrieval_ref": {
            "minLength": 1,
            "title": "Retrieval Ref",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "size_bytes": {
            "minimum": 0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "digest",
          "mime_type",
          "size_bytes",
          "retrieval_ref",
          "retention_ref"
        ],
        "title": "ArtifactRef",
        "type": "object"
      },
      "EffectIntent": {
        "additionalProperties": false,
        "properties": {
          "intent_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Intent Hash",
            "type": "string"
          },
          "operation_id": {
            "minLength": 1,
            "title": "Operation Id",
            "type": "string"
          },
          "request_ref": {
            "minLength": 1,
            "title": "Request Ref",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "operation_id",
          "intent_hash",
          "request_ref"
        ],
        "title": "EffectIntent",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "intent": {
        "$ref": "#/$defs/EffectIntent"
      },
      "receipt": {
        "anyOf": [
          {
            "$ref": "#/$defs/ActionReceipt"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "status": {
        "default": "pending",
        "enum": [
          "pending",
          "succeeded",
          "failed",
          "unknown_effect"
        ],
        "title": "Status",
        "type": "string"
      },
      "task_id": {
        "minLength": 1,
        "title": "Task Id",
        "type": "string"
      },
      "workspace_id": {
        "minLength": 1,
        "title": "Workspace Id",
        "type": "string"
      }
    },
    "required": [
      "workspace_id",
      "task_id",
      "intent"
    ],
    "title": "OperationView",
    "type": "object"
  },
  "StoredStep": {
    "$defs": {
      "TaskSnapshot": {
        "additionalProperties": false,
        "properties": {
          "policy_hash": {
            "title": "Policy Hash",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "state_version": {
            "default": 0,
            "minimum": 0,
            "title": "State Version",
            "type": "integer"
          },
          "status": {
            "$ref": "#/$defs/TaskStatus",
            "default": "queued"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "workspace_id": {
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "task_id",
          "policy_hash"
        ],
        "title": "TaskSnapshot",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "queued",
          "running",
          "waiting_input",
          "waiting_event",
          "waiting_approval",
          "retry_delay",
          "reconciling",
          "cancelling",
          "succeeded",
          "partial",
          "failed",
          "cancelled",
          "unknown_effect"
        ],
        "title": "TaskStatus",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "seq": {
        "minimum": 1,
        "title": "Seq",
        "type": "integer"
      },
      "snapshot": {
        "$ref": "#/$defs/TaskSnapshot"
      }
    },
    "required": [
      "seq",
      "snapshot"
    ],
    "title": "StoredStep",
    "type": "object"
  }
}
